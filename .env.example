# Copy to .env and fill in. Placeholders only; never commit real values.

# --- PostgreSQL (Airflow + Superset metadata only) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
AIRFLOW_DB=airflow
SUPERSET_DB=superset

# --- Redis (Celery broker) ---
REDIS_PASSWORD=change-me

# --- Airflow ---
AIRFLOW_FERNET_KEY=change-me-generate-with-cryptography-fernet
AIRFLOW_JWT_SECRET=change-me
AIRFLOW_API_SECRET_KEY=change-me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# --- SeaweedFS (S3 gateway) ---
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=ksei-lake
S3_LOGS_BUCKET=airflow-logs

# --- ClickHouse ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_ADMIN_USER=admin
CLICKHOUSE_ADMIN_PASSWORD=change-me
CLICKHOUSE_PIPELINE_USER=pipeline
CLICKHOUSE_PIPELINE_PASSWORD=change-me
CLICKHOUSE_SUPERSET_USER=superset_ro
CLICKHOUSE_SUPERSET_PASSWORD=change-me

# --- Superset ---
SUPERSET_SECRET_KEY=change-me
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-me

# --- KSEI HTTP client ---
KSEI_USER_AGENT=ksei-holding-pipeline/0.1 (portfolio project; contact: you@example.com)
KSEI_MIN_DELAY_SECONDS=5
KSEI_BASE_URL=https://web.ksei.co.id

# --- Period calendar (loaded once by the period-init service) ---
# Direct-download form of the shared file; only the file id differs from the share link.
PERIOD_SOURCE_URL=https://drive.google.com/uc?export=download&id=1H5O1GR6R7OoX8me_5FDmv70xsK977etu
